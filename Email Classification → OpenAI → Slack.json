    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const email = $('Gmail Trigger').item.json;\nconst raw = $input.item.json;\n\n// Find the model's text output regardless of node version/shape\nlet text = raw?.output?.[0]?.content?.[0]?.text\n  || raw?.message?.content\n  || raw?.text\n  || raw?.content\n  || '';\nif (typeof text !== 'string') text = JSON.stringify(text);\n\nlet parsed;\ntry {\n  parsed = JSON.parse(text.replace(/```json|```/g, '').trim());\n} catch (e) {\n  parsed = { category: 'Other', priority: 'Medium', summary: 'Could not parse AI response', action: 'Review manually' };\n}\n\nconst emojiMap = {\n  'Urgent': '🚨', 'Customer Support': '🎧', 'Sales/Lead': '💰', 'Invoice/Billing': '🧾',\n  'Meeting/Calendar': '📅', 'Newsletter/Promotion': '📰', 'Spam': '🗑️', 'Personal': '👤', 'Other': '📧'\n};\nconst prioMap = { High: '🔴', Medium: '🟠', Low: '🟢' };\n\nreturn {\n  json: {\n    from: email.From || '',\n    subject: email.Subject || '(no subject)',\n    category: parsed.category || 'Other',\n    priority: parsed.priority || 'Medium',\n    summary: parsed.summary || '',\n    action: parsed.action || '',\n    emoji: emojiMap[parsed.category] || '📧',\n    prioEmoji: prioMap[parsed.priority] || '🟠',\n    link: `https://mail.google.com/mail/u/0/#inbox/${email.id}`\n  }\n};"
      },
